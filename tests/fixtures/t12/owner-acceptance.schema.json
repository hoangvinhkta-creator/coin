{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "asOfDate",
    "plan",
    "openingPosition",
    "events",
    "expected",
    "tolerance"
  ],
  "additionalProperties": false,
  "properties": {
    "asOfDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "plan": {
      "type": "object"
    },
    "openingPosition": {
      "type": [
        "object",
        "null"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expected": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ethQty": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000000
            },
            {
              "enum": [
                null,
                "UNKNOWN"
              ]
            }
          ]
        },
        "avgCostUsdt": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000000
            },
            {
              "enum": [
                null,
                "UNKNOWN"
              ]
            }
          ]
        },
        "avgCostVnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000000
            },
            {
              "enum": [
                null,
                "UNKNOWN"
              ]
            }
          ]
        },
        "investedThisMonthVnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000000
            },
            {
              "enum": [
                null,
                "UNKNOWN"
              ]
            }
          ]
        },
        "planInvestedVnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000000
            },
            {
              "enum": [
                null,
                "UNKNOWN"
              ]
            }
          ]
        },
        "remainingPlannedBudgetVnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000000
            },
            {
              "enum": [
                null,
                "UNKNOWN"
              ]
            }
          ]
        },
        "reserveBalanceVnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000000
            },
            {
              "enum": [
                null,
                "UNKNOWN"
              ]
            }
          ]
        },
        "nextPlannedAmountVnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9000000000000000
            },
            {
              "enum": [
                null,
                "UNKNOWN"
              ]
            }
          ]
        },
        "nextPlannedDate": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tolerance": {
      "type": "object",
      "required": [
        "vnd",
        "usdt",
        "qty"
      ],
      "additionalProperties": false,
      "properties": {
        "vnd": {
          "const": 0
        },
        "usdt": {
          "const": 0
        },
        "qty": {
          "const": 0
        }
      }
    }
  }
}
